POSTGRES_DB=workforce
APP_ENV=production
POSTGRES_USER=workforce
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://workforce:change-me@postgres:5432/workforce
REDIS_URL=redis://redis:6379/0
INSTALLATION_TOKEN=replace-with-a-long-random-token
DEVICE_TOKEN_PEPPER=replace-with-a-different-long-random-secret
JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_COOKIE_SECURE=true
# Используются только для создания первого superadmin при пустой таблице users.
# После первого запуска удалите пароль из .env.
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Системный администратор
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
MINIO_BUCKET=workforce-media
MINIO_SECURE=false
MEDIAMTX_WEBRTC_HOSTS=127.0.0.1
MEDIAMTX_INTERNAL_URL=http://mediamtx:9997
MEDIAMTX_PUBLISH_URL=https://workforce.local/webrtc
MEDIAMTX_RTSP_PUBLISH_URL=rtsp://workforce.local:8554
MEDIAMTX_PLAYBACK_URL=http://mediamtx:9996
VIDEO_RECORDING_ROOT=/recordings
STORAGE_HIGH_WATERMARK_PERCENT=85
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=workforce-monitoring@company.ru
SMTP_STARTTLS=true
PRESENCE_TTL_SECONDS=90
HEARTBEAT_INTERVAL_SECONDS=30
VITE_API_URL=/api/v1
RUN_BACKGROUND_WORKERS=false
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
