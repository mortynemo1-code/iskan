<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Workforce.Agent.Shared\Workforce.Agent.Shared.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- System.Windows.Automation lives in the WPF profile. Referencing the profile
         directly keeps the WinForms implicit usings, which UseWPF would replace. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>
</Project>
